# ─────────────────────────────────────────────────────────────────────────────
# Aegis Secrets Broker — Environment Configuration
# Copy to .env and fill in all required values before starting.
# Generate secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# In production, point at pgBouncer (see docker-compose.prod.yml)
DATABASE_URL=postgresql://broker:changeme@pgbouncer:5432/aegis

# Dev only (direct Postgres, no pooling):
# DATABASE_URL=postgresql://broker:changeme@postgres:5432/aegis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth config ───────────────────────────────────────────────────────────────
# Path to auth.json inside the container (mounted volume)
AUTH_PATH=/config/auth.json

# ── Admin credentials ─────────────────────────────────────────────────────────
# Admin panel login and HTTP Basic auth on /admin/api/*
ADMIN_PASSWORD=changeme

# Session signing secret — random, minimum 32 chars
# Generate: openssl rand -hex 32
SECRET_KEY=changeme-replace-with-random-value

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Global default requests/minute per API key (overridable per team/registry via policy)
RATE_LIMIT_RPM=60

# ── Log destinations ──────────────────────────────────────────────────────────
# Comma-separated list. stdout is always active.
# Options: stdout, s3, siem, splunk, datadog
LOG_DESTINATIONS=stdout

# S3 (audit log archival)
# S3_LOG_BUCKET=my-audit-logs
# S3_LOG_PREFIX=aegis/audit
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# SIEM (generic HTTP ingest endpoint)
# LOG_SIEM_URL=https://siem.example.com/ingest
# LOG_SIEM_TOKEN=

# Splunk HEC
# SPLUNK_HEC_URL=https://splunk:8088
# SPLUNK_HEC_TOKEN=

# Datadog
# DD_API_KEY=
# DD_SITE=datadoghq.com

# ── Outbound webhook safety ───────────────────────────────────────────────────
# Team webhook and notification URLs are requested by the broker itself, so they
# are validated against these rules before being stored or delivered to.
# WEBHOOK_ALLOWED_SCHEMES=https
# WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,example.com
# Local development only — permits loopback/private targets:
# WEBHOOK_ALLOW_PRIVATE_IPS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Behaviour when Redis is unreachable: "open" keeps serving without enforcing
# limits, "closed" rejects requests instead.
# RATE_LIMIT_FAIL_MODE=open

# ── ESO secret cache ──────────────────────────────────────────────────────────
# Caches brokered fetches for the ESO endpoints so a timer-driven refresh does
# not hit the upstream vault every tick. Off by default: the cache holds
# plaintext credentials, and it is in-process rather than in Redis so a Redis
# compromise cannot reach it.
# SECRET_CACHE_TTL_SECONDS=0
# SECRET_CACHE_MAX_ENTRIES=512
# Set false to stop /eso/v1/secrets returning an entire registry at once.
# ESO_ALLOW_REGISTRY_EXTRACT=true

# ── Key expiry ────────────────────────────────────────────────────────────────
# enforce (default) rejects expired keys; warn allows them but audits the use,
# so you can find out what is still running on an expired key before it breaks.
# KEY_EXPIRY_MODE=enforce
# The key-expiry/rotation job. Safe to leave on in every replica — it takes a
# Postgres advisory lock so only one instance rotates.
# SCHEDULER_ENABLED=true

# ── Secret scanning alerts ────────────────────────────────────────────────────
# Which channels raise a ticket/alert when a scanner reports a credential.
# Empty (the default) disables alerting entirely.
# ALERT_SINKS=jira,email
# ALERT_MIN_SEVERITY=high
# ALERT_MAX_PER_RUN=25
# background (default) delivers alerts off the ingest request so a slow Jira
# cannot hold a CI request open; sync makes ingest wait for the sinks.
# ALERT_DISPATCH_MODE=background
# ALERT_WORKERS=2
# Public base URL, so alerts can link back to the finding:
# AEGIS_BASE_URL=https://aegis.example.com

# Jira
# JIRA_URL=https://your-org.atlassian.net
# JIRA_USER=bot@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SEC
# JIRA_ISSUE_TYPE=Task

# ServiceNow
# SERVICENOW_URL=https://your-org.service-now.com
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=
# SERVICENOW_TABLE=incident

# Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=aegis@example.com
# SMTP_STARTTLS=true
# ALERT_EMAIL_TO=security@example.com

# Generic webhook
# ALERT_WEBHOOK_URL=

# ── Kubernetes ────────────────────────────────────────────────────────────────
# The Helm chart sets this to false and migrates once in a PreSync Job instead,
# so replicas never race to migrate the same database.
# RUN_MIGRATIONS=true

# ── TLS / Caddy (production only) ─────────────────────────────────────────────
# Used by docker-compose.prod.yml Caddy service for automatic TLS
AEGIS_DOMAIN=aegis.example.com
TLS_EMAIL=ops@example.com

# ── PostgreSQL (docker-compose managed) ───────────────────────────────────────
POSTGRES_DB=aegis
POSTGRES_USER=broker
POSTGRES_PASSWORD=changeme

# ── Backup (production) ───────────────────────────────────────────────────────
# S3 bucket for pg_dump backups (docker-compose.prod.yml backup service)
# BACKUP_S3_BUCKET=my-aegis-backups
# BACKUP_S3_PREFIX=pgdump
# BACKUP_RETAIN_DAYS=30
